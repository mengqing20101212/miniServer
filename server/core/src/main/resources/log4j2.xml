<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <!-- 控制台输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level - %msg%n"/>
        </Console>
        <!-- 网络日志 -->
        <RollingFile name="netRollingFile" fileName="logs/net.log"
                     filePattern="logs/net-%d{yyyy-MM-dd}.log">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>

        <!-- 协议日志 -->
        <RollingFile name="protoRollingFile" fileName="logs/protobuf.log"
                     filePattern="logs/proto-%d{yyyy-MM-dd}.log">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>

        <!-- 系统日志 -->
        <RollingFile name="systemRollingFile" fileName="logs/system.log"
                     filePattern="logs/system-%d{yyyy-MM-dd}.log">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>

        <!-- 数据库日志 -->
        <RollingFile name="DbRollingFile" fileName="logs/db.log"
                     filePattern="logs/db-%d{yyyy-MM-dd}.log">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>

        <!-- 姝讳俊鏃ュ織 -->
        <RollingFile name="deadLetterRollingFile" fileName="logs/dead-letter.log"
                     filePattern="logs/dead-letter-%d{yyyy-MM-dd}.log">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- 指定 net 和 system 的 Logger -->
        <Logger name="netLogger" level="DEBUG" additivity="false">
            <AppenderRef ref="netRollingFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="protoLogger" level="DEBUG" additivity="false">
            <AppenderRef ref="protoRollingFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="systemLogger" level="INFO" additivity="false">
            <AppenderRef ref="systemRollingFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="DbLogger" level="DEBUG" additivity="false">
            <AppenderRef ref="DbRollingFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="deadLetterLogger" level="WARN" additivity="false">
            <AppenderRef ref="deadLetterRollingFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
